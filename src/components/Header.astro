---
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header>
  <div class="band" aria-hidden="true"></div>
  <div class="wrap bar">
    <a class="wordmark" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><button class="theme-toggle" type="button" data-theme-toggle>Dark mode</button></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => {
    if (btn) btn.textContent = root.dataset.theme === 'dark' ? 'Light mode' : 'Dark mode';
  };
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked (private window). The choice still applies for this page view.
    }
    sync();
  });
  sync();
</script>
