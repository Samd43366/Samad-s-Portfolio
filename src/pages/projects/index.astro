---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Projects" description="Projects I am building, with the decisions behind each.">
  <div class="wrap page-head">
    <h1>Projects</h1>
    <p class="lede">What I'm building, with the decisions behind each.</p>
  </div>
  <div class="wrap project-grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>
